{
  "name": "vsluh",
  "version": "2.0.0",
  "description": "Вслух — музыкальный плеер",
  "main": "main.js",
  "author": "Aung",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "prebuild": "node tools/clean-dist.js",
    "clean": "node tools/clean-dist.js"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.15.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.vsluh.player",
    "productName": "Vsluh",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "lib/**",
      "assets/**"
    ],
    "asarUnpack": [
      "**/node_modules/@coooookies/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Vsluh-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Вслух",
      "uninstallDisplayName": "Вслух"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AungSueZ",
        "repo": "VsluhPlayer"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "synopsis": "Плеер с текстом песни",
      "description": "Музыкальный плеер: синхронный текст песни, визуализации, темы.",
      "desktop": {
        "entry": {
          "Name": "Вслух",
          "Comment": "Плеер с текстом песни",
          "Keywords": "music;player;lyrics;"
        }
      },
      "artifactName": "Vsluh-${version}-x86_64.${ext}"
    }
  },
  "optionalDependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12"
  }
}
